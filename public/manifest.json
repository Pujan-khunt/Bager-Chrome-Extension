{
  "name": "Bager",
  "description": "Convert your mess of bookmarks into an organized pile.",
  "author": "Pujan Khunt",
  "version": "0.0.0",
  "manifest_version": 3,
  "permissions": ["scripting", "bookmarks"],
  "action": {
    "default_title": "Bager",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content/content.js"]
    }
  ]
}
